{
	"name": "oma-peli",
	"version": "1.7.0",
	"private": true,
	"license": "MIT",
	"scripts": {
		"format": "prettier --write --ignore-path=../../.prettierignore .",
		"lint": "eslint \"src\"",
		"storybook": "PUBLIC_CHROMATIC=true storybook dev -p 6001 public",
		"dev": "vite dev --host --port 3010",
		"build": "vite build",
		"build:stake": "cross-env OMA_PELI_BUILD_TARGET=stake vite build",
		"preview": "vite preview",
		"audit:screens": "node scripts/capture-audit-screenshots.mjs",
		"test:reel-stop": "node --experimental-transform-types scripts/test-reel-stop.mjs",
		"test:domain": "node scripts/run-domain-tests.mjs",
		"audit:resources": "node scripts/audit-resources.mjs",
		"audit:math": "node scripts/run-rtp-audit.mjs --experimental",
		"audit:baseline": "node scripts/run-rtp-audit.mjs",
		"audit:experiment": "node scripts/run-rtp-audit.mjs --experimental"
	},
	"type": "module",
	"devDependencies": {
		"esbuild": "0.25.12",
		"@storybook/addon-svelte-csf": "5.0.5",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/vite-plugin-svelte": "5.0.3",
		"chromatic": "11.26.1",
		"config-lingui": "workspace:*",
		"config-storybook": "workspace:*",
		"config-svelte": "workspace:*",
		"config-ts": "workspace:*",
		"config-vite": "workspace:*",
		"cross-env": "^10.1.0",
		"eslint": "9.21.0",
		"eslint-config-custom": "workspace:*"
	},
	"dependencies": {
		"@lingui/core": "5.2.0",
		"@sveltejs/kit": "2.17.3",
		"@types/howler": "2.2.12",
		"@types/lodash": "4.17.16",
		"components-layout": "workspace:*",
		"components-pixi": "workspace:*",
		"components-shared": "workspace:*",
		"components-storybook": "workspace:*",
		"components-ui-html": "workspace:*",
		"components-ui-pixi": "workspace:*",
		"constants-shared": "workspace:*",
		"envs": "workspace:*",
		"howler": "2.2.4",
		"lodash": "4.17.16",
		"pixi-svelte": "workspace:*",
		"pixi.js": "8.8.1",
		"rgs-requests": "workspace:*",
		"state-shared": "workspace:*",
		"svelte": "5.20.5",
		"utils-bet": "workspace:*",
		"utils-book": "workspace:*",
		"utils-event-emitter": "workspace:*",
		"utils-layout": "workspace:*",
		"utils-shared": "workspace:*",
		"utils-slots": "workspace:*",
		"utils-sound": "workspace:*",
		"utils-xstate": "workspace:*",
		"vite": "6.2.0"
	}
}
